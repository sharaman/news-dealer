# LLM
OPENAI_API_KEY=sk-...

# Langfuse observability
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# MCP Server
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000

# Allowed sources (comma-separated, immutable at runtime)
ALLOWED_MEDIUM_TOPICS=artificial-intelligence,machine-learning,python,llm
ALLOWED_TELEGRAM_CHANNELS=tlgur,ai_newz

# Medium.com authentication (optional)
# Получить: DevTools → Application → Cookies → medium.com → значение cookie "sid"
MEDIUM_SID=

# Telegram publishing (required for make publish / make publish-demo)
# 1. Создайте бота через @BotFather → получите токен
# 2. Добавьте бота администратором в канал
# 3. Укажите @username канала или числовой ID (-1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLISH_CHANNEL=

# RAG
CHROMA_PERSIST_DIR=./chroma_db

# Session
SQLITE_DB_PATH=./sessions.db

# Default user interests (comma-separated)
DEFAULT_USER_INTERESTS=AI,machine learning,Python,LLM,neural networks,data science

# Post generation
MAX_ARTICLES_IN_POST=3

# Security
MAX_MESSAGE_LENGTH=1000
